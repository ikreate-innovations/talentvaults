{
  "name": "talent-vaults",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "clean": "rm -rf .next && rm -rf node_modules",
    "clean:windows": "rmdir /s /q .next 2>nul && rmdir /s /q node_modules 2>nul",
    "reinstall": "npm cache clean --force && rm -f package-lock.json && npm install",
    "reinstall:windows": "npm cache clean --force && del package-lock.json 2>nul && npm install"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.86.2",
    "axios": "^1.13.2",
    "dotenv": "^17.2.3",
    "next": "^14.2.33",
    "next-auth": "^5.0.0-beta.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.22",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.33",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.3.0"
  }
}